<div class="row g-4 mb-5">

  <div class="col-md-12">

    <div class="card border-0 shadow-sm">

      <div class="card-body">

        <h5 class="fw-bold mb-3">
          Quick Actions
        </h5>

        <div class="d-flex flex-wrap gap-3">

          <%= link_to "View Students",
              students_path,
              class: "btn btn-outline-dark" %>

          <%= link_to "Add Student",
              new_student_path,
              class: "btn btn-dark" %>

          <% if admin? %>

            <%= link_to "View Teachers",
                users_path,
                class: "btn btn-outline-primary" %>

          <% end %>

        </div>

      </div>

    </div>

  </div>

</div>
