<div class="d-flex justify-content-between align-items-center mb-5">

  <div>

    <h1 class="fw-bold mb-1">

      <% if admin? %>
        Admin Dashboard
      <% else %>
        Welcome back, <%= current_user.name %>!
      <% end %>

    </h1>

    <p class="text-secondary mb-0">

      <% if admin? %>
        Student Management Analytics Overview
      <% else %>
        You are viewing only students managed by you.
      <% end %>
      
    </p>

  </div>

  <%= link_to "Add Student",
      new_student_path,
      class: "btn btn-dark" %>

</div>
