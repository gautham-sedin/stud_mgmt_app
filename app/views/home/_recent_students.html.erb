<div class="card border-0 shadow-sm">

  <div class="card-body">

    <div class="d-flex justify-content-between align-items-center mb-4">

      <div>

        <h4 class="fw-bold mb-1">
          Recent Students
        </h4>

        <p class="text-secondary mb-0">
          Latest added student records
        </p>

      </div>

      <%= link_to "View All",
          students_path,
          class: "btn btn-outline-dark btn-sm" %>

    </div>

    <% if @recent_students.any? %>

      <div class="table-responsive">

        <table class="table align-middle">

          <thead class="table-light">

            <tr>

              <th>Name</th>
              <th>Course</th>
              <th>Marks</th>
              <th>Result</th>

              <% if admin? %>
                <th>Teacher</th>
              <% end %>

            </tr>

          </thead>

          <tbody>

            <% @recent_students.each do |student| %>

              <tr>

                <td class="fw-semibold">
                  <%= student.name %>
                </td>

                <td>

                  <span class="badge <%= course_badge_class(student.course) %>">
                    <%= student.course %>
                  </span>

                </td>

                <td>
                  <%= student.marks || "N/A" %>
                </td>

                <td>

                  <% if student.result == "Pass" %>

                    <span class="badge bg-success">
                      Pass
                    </span>

                  <% elsif student.result == "Fail" %>

                    <span class="badge bg-danger">
                      Fail
                    </span>

                  <% else %>

                    <span class="badge bg-secondary">
                      N/A
                    </span>

                  <% end %>

                </td>

                <% if admin? %>

                  <td>
                    <%= student.user&.name || 'Not Assigned' %>
                  </td>

                <% end %>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    <% else %>

      <div class="text-center py-4">

        <h5 class="fw-bold">
          No Students Available
        </h5>

        <p class="text-secondary">
          Add students to view analytics.
        </p>

      </div>

    <% end %>

  </div>

</div>
