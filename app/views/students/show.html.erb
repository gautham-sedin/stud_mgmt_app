<div>
    <div>
        <h1 class="fw-bold mb-1">
            Students details page
        </h1>

        <p class="text-secondary mb-0">
            Complete information about the student.
        </p>
    </div>

    <div class="d-flex gap-2 mt-3">
        <%= link_to "Edit",
        edit_student_path(@student),
        class: "btn btn-outline-primary" %>

        <%= link_to "Delete",
        student_path(@student),
        data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure you want to delete this student?"
        },
        class: "btn btn-outline-danger" %>
    </div>

    <div class="card border-3 shadow-sm mt-4">
        <div class="card-body p-5">

            <div class="d-flex justify-content-center mb-4">
                
                <% if @student.profile_photo.attached? %>

                    <%= image_tag @student.profile_photo,
                        class: "rounded border shadow",
                        style: "width: 270px; height: 270px; object-fit: cover;" %>

                <% else %>
                
                    <div class="rounded bg-light border d-inline-flex justify-content-center align-items-center shadow" style="width: 270px; height: 270px;">
                        <span class="text-secondary">
                            No profile photo
                        </span>
                    </div>

                <% end %>

            </div>

            <div class="row">
                <div class="col-md-6 mb-4">

                    <h6 class="text-secondary mb-2">Name: </h6>
                    <h4 class="fw-bold"><%= @student.name %></h4>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-secondary mb-2">Email: </h6>
                    <h4 class="fw-bold"><%= @student.email %></h4>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-secondary mb-2">Age: </h6>
                    <h4><%= @student.age %></h4>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-secondary mb-2">Course: </h6>
                    <h4 class="badge fs-6 px-3 py-2 <%= course_badge_class(@student.course) %>"><%= @student.course %></h4>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-secondary mb-2">City: </h6>
                    <h4><%= @student.city %></h4>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-secondary mb-2">Marks: </h6>
                    <h4><%= @student.marks || "N/A" %></h4>

                </div>

                <div class="col-md-6 mb-4">
                    <h6 class="text-secondary mb-2">Teacher: </h6>
                    <h4><%= @student.user&.email || "Not Assigned" %></h4>
                </div>

                <div class="col-md-6 mb-4">
                    <h6 class="text-secondary mb-2">Result: </h6>

                    <% if @student.result == "Pass" %>

                    <span class="badge bg-success fs-6 px-3 py-2">
                        Pass
                    </span>

                    <% elsif @student.result == "Fail" %>

                    <span class="badge bg-danger fs-6 px-3 py-2">
                        Fail
                    </span>

                    <% else %>

                    <span class="badge bg-secondary fs-6 px-3 py-2">
                        N/A
                    </span>
                    
                    <% end %>
                </div>

            </div>

            <hr class="my-4">

            <h4 class="fw-semibold mb-3">
                Student Documents
                (<%= @student.documents.count %>)
            </h4>

            <% if @student.documents.attached? %>

                <div class="list-group mb-4">

                    <% @student.documents.each do |document| %>

                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <%= document.filename.to_s %>
                                <span class="text-muted">
                                    (<%= number_to_human_size(document.byte_size) %>) 
                                </span>
                            </span>

                            <span class="d-flex gap-2">

                                <%= link_to "Download",
                                    rails_blob_path(document, disposition: "attachment"),
                                    class: "btn btn-outline-dark btn-sm" %>

                                <%= link_to "Delete",
                                    remove_document_student_path(@student, attachment_id: document.id),
                                    data: {
                                        turbo_method: :delete,
                                        turbo_confirm: "Are you sure you want to delete this document?"
                                    },
                                    class: "btn btn-outline-danger btn-sm" %>

                            </span>
                        </div>

                    <% end %>

                </div>

            <% else %>

                <div class="alert alert-secondary mb-4" role="alert">
                    No documents uploaded.
                </div>

            <% end %>

            <hr class="my-4">

            <div class="d-flex gap-3">
                <%= link_to "Back to Students",
                students_path,
                class: "btn btn-dark" %>

                <%= link_to "Add new Student",
                new_student_path,
                class: "btn btn-outline-dark" %>
            </div>

        </div>


    </div>

</div>