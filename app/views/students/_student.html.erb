<tr id="<%= dom_id(student) %>">

  <td class="fw-semibold">
    <%= student.name %>
  </td>

  <td>
    <%= student.email %>
  </td>

  <td>
    <%= student.age %>
  </td>

  <td>
    <span class="badge <%= course_badge_class(student.course) %>">
      <%= student.course %>
    </span>
  </td>

  <td>
    <%= student.city %>
  </td>

  <% if admin? %>
    <td>
      <%= student.user&.name || "Not Assigned" %>
    </td>
  <% end %>

  <td class="text-center">

    <div class="d-flex justify-content-center gap-2">

      <%= link_to "View",
          student_path(student),
          data: {
            turbo_frame: "_top"
          },
          class: "btn btn-sm btn-outline-dark" %>

    <%= link_to "Edit",
            edit_student_path(student),
            data: {
                turbo_frame: "student_form"
            },
            class: "btn btn-sm btn-outline-primary" %>

      <%= link_to "Delete",
          student_path(student),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure?"
          },
          class: "btn btn-sm btn-outline-danger" %>

    </div>

  </td>

</tr>