<%= turbo_stream.append "students" do %>
  <%= render @student %>
<% end %>

<%= turbo_stream.replace "student_count" do %>
  <%= render "student_count",
      student_count: @student_count %>
<% end %>

<%= turbo_stream.replace "student_form" do %>
  <%= turbo_frame_tag "student_form" do %>
    <%= render "quick_form",
        student: Student.new %>
  <% end %>
<% end %>

<%= turbo_stream.replace "flash_messages" do %>
  <%= render "shared/flash" %>
<% end %>