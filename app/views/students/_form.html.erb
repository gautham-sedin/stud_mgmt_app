<div class="card shadow-sm border-0">

  <div class="card-body p-4">

    <% if @student.errors.any? %>

      <div class="alert alert-danger">

        <h5 class="fw-bold">
          Please fix the following errors:
        </h5>

        <ul class="mb-0 mt-3">

          <% @student.errors.full_messages.each do |message| %>

            <li>
              <%= message %>
            </li>

          <% end %>

        </ul>

      </div>

    <% end %>


    <%= form_with model: @student, local: true do |form| %>

      <div class="row">

        <div class="col-md-6 mb-4">

          <%= form.label :name,
                class: "form-label fw-semibold" %>

          <%= form.text_field :name,
                class: "form-control",
                placeholder: "Enter student name" %>

        </div>


        <div class="col-md-6 mb-4">

          <%= form.label :email,
                class: "form-label fw-semibold" %>

          <%= form.email_field :email,
                class: "form-control",
                placeholder: "Enter email address" %>

        </div>


        <div class="col-md-4 mb-4">

          <%= form.label :age,
                class: "form-label fw-semibold" %>

          <%= form.number_field :age,
                class: "form-control",
                placeholder: "Age" %>

        </div>


        <div class="col-md-4 mb-4">

          <%= form.label :course,
                class: "form-label fw-semibold" %>

          <%= form.select :course,
                Student::COURSES,
                { prompt: "Select Course" },
                class: "form-select" %>

        </div>

        <% if current_user.admin? %>

          <div class="col-md-4 mb-4">

            <%= form.label :user_id,
                  "Teacher",
                  class: "form-label fw-semibold" %>

            <%= form.collection_select :user_id,
                  User.teacher.order(:name),
                  :id,
                  :name,
                  { prompt: "Select Teacher" },
                  class: "form-select" %>

          </div>

        <% end %>

        <div class="col-md-4 mb-4">

          <%= form.label :marks,
                class: "form-label fw-semibold" %>

          <%= form.number_field :marks,
                class: "form-control",
                placeholder: "Marks" %>

        </div>

        <div class="col-12 mb-4">

          <%= form.label :city,
                class: "form-label fw-semibold" %>

          <%= form.text_field :city,
                class: "form-control",
                placeholder: "Enter city name" %>

        </div>

      </div>

      <hr class="my-4">

      <h4 class="fw-semibold mb-3">
        Student Documents
      </h4>

        <div class="row">

          <%# Profile photo upload column %>
          <div class="card border-0 bg-light mb-4">
            <div class="card-body">
              <h5 class="fw-semibold mb-3">
                Profile Photo
              </h5>

              <%= form.file_field :profile_photo,
                    class: "form-control",
                    accept: ".jpg,.jpeg,.png" %>

              <small class="text-muted">JPG, JPEG or PNG • Maximum 5 MB</small>
            </div>
          </div>

          <%# Profile photo view area %>
          <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm border-0">
              
              <% if @student.profile_photo.attached? %>
              <div class="card-body d-flex flex-column justify-content-between">

                <%= image_tag @student.profile_photo,
                  class: "img-fluid rounded mb-3",
                  style: "max-height:180px; max-width: 180px;" %>
                <small class="text-muted mb-2">
                  (<%= number_to_human_size(@student.profile_photo.byte_size) %>)
                </small>

                <div class="d-flex gap-2">

                  <%= link_to "View",
                      url_for(@student.profile_photo),
                      target: "_blank",
                      class: "btn btn-outline-primary btn-sm" %>
                
                  <%= link_to "Delete",
                      remove_profile_photo_student_path(@student),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure you want to delete the profile photo?"
                      },
                      class: "btn btn-outline-danger btn-sm" %>

                </div>

              </div>
              <% else %>
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                  <span class="text-secondary">
                    No profile photo uploaded.
                  </span>
                </div>
              <% end %>

            </div>
          </div>

          <%# Student documents upload column %>
          <div class="card border-0 bg-light mb-4">
            <div class="card-body">
              <h5 class="fw-semibold mb-3">
                Documents
                (<%= @student.documents.count %>)
              </h5>

              <%= form.file_field :documents,
                    multiple: true,
                    class: "form-control",
                    accept: ".pdf,.jpg,.jpeg,.png" %>

              <small class="text-muted">PDF, JPG, JPEG or PNG • Maximum 10 MB each</small>

            </div>
          </div>

          <% if @student.documents.attached? %>

            <% @student.documents.each do |document| %>

              <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm border-0">
                  <div class="card-body d-flex flex-column justify-content-between">
                    
                    <h6 class="card-title text-truncate">
                      <%= document.filename.to_s %>
                    </h6>
                    <small class="text-muted mb-2">
                      (<%= number_to_human_size(document.byte_size) %>)
                    </small>

                    <div class="d-flex gap-2">

                      <%= link_to "View",
                          url_for(document),
                          target: "_blank",
                          class: "btn btn-outline-primary btn-sm" %>

                      <%= link_to "Delete",
                          remove_document_student_path(@student, attachment_id: document.id),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure you want to delete this document?"
                          },
                          class: "btn btn-outline-danger btn-sm" %>

                    </div>

                  </div>
                </div>
              </div>

            <% end %>

          <% else %>

            <div class="card-body d-flex flex-column justify-content-center align-items-center">
              <span class="text-secondary">
                No documents uploaded.
              </span>
            </div>

          <% end %>

      <hr class="my-4">

      <div class="d-flex gap-3">

        <%= form.submit class: "btn btn-dark px-4" %>

        <%= link_to "Back",
            students_path,
            class: "btn btn-outline-secondary" %>

      </div>

    <% end %>

  </div>
</div>