<%= turbo_stream.replace dom_id(@student) do %>
  <%= render @student %>
<% end %>

<%= turbo_stream.replace "student_form" do %>
  <%= turbo_frame_tag "student_form" do %>
    <%= render "quick_form",
        student: Student.new %>
  <% end %>
<% end %>

<%= turbo_stream.replace "flash_messages" do %>
  <%= render "shared/flash" %>
<% end %>