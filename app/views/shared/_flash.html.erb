<% flash.each do |type, message| %>

    <% bootstrap_class =
        case type
        when "notice"
            "success"
        when "alert"
            "danger"
        else
            "info"
        end
    %>

    <div class="alert alert-<%= bootstrap_class %> alert-dismissible fade show shadow-sm" role="alert">
        <%= message %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert">
        </button>
    </div>

<% end %>