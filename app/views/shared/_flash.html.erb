<% flash.each do |type, message| %>
    <% next if message.blank? %>
    <div class="alert alert-<%= flash_bootstrap_class(type) %> alert-dismissible fade show shadow-sm" role="alert" data-turbo-temporary>
        <%= message %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert">
        </button>
    </div>
<% end %>
