<h2>
    New Student Assigned
</h2>

<p>
    Hello <%= @teacher.name %>,
</p>

<p>
    A new student has been assigned to you.
</p>

<p>
    <strong>Student:</strong>
    <%= @student.name %>
</p>

<p>
    <strong>Email:</strong>
    <%= @student.email %>
</p>

<p>
    <strong>Course:</strong>
    <%= @student.course %>
</p>

<p>
    Please log in to the Student Management System for more details.
</p>

<p>
    Regards,<br>
    SedStudents Team
</p>