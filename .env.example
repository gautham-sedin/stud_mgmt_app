# .env.example
# ─────────────────────────────────────────────────────────────────────
# HOW TO USE THIS FILE:
# 1. Copy it: cp .env.example .env
# 2. Fill in the real values in .env
# 3. NEVER commit .env to Git (it is in .gitignore)
# 4. Get RAILS_MASTER_KEY from your team lead or from config/master.key
# ─────────────────────────────────────────────────────────────────────

# Required: Rails master key to decrypt config/credentials.yml.enc
RAILS_MASTER_KEY=your_master_key_here
